# ==============================================================================
# OPTENARY PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' or '.env.local' in the project root:
#   cp .env.example .env
#
# Vite exposes variables prefixed with VITE_ to the client bundle.
# Never commit real private keys or service role secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & CANONICAL URL
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://optenary.in
VITE_APP_URL=https://app.optenary.in

# ------------------------------------------------------------------------------
# 2. SUPABASE BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard -> Project Settings -> API.
# If these variables are left empty, Optenary automatically uses its built-in
# offline persistent storage engine with full local data continuity.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# 3. CONTACT FORM & TELEGRAM NOTIFICATION DISPATCHER
# ------------------------------------------------------------------------------
# When visitors submit the public Contact form or Onboarding intake,
# instant notifications are dispatched to your team's Telegram channel.
# Create a bot via @BotFather and retrieve your Chat ID via @userinfobot.
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

